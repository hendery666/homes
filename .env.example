# ---------- Frontend (Vite) ----------
# Firebase web app config: Firebase console → Project settings → Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# Optional: enables Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Maps JavaScript API key (Places API enabled)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Payment server URL: http://localhost:4242 locally, your deployed server in production
VITE_API_URL=http://localhost:4242

# ---------- Payment server (server.js) ----------
# Stripe secret key (use a test key: sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Price IDs for the boost plans (Stripe dashboard → Products)
PRICE_ID_1D=price_your_1day_price_id
PRICE_ID_7D=price_your_7day_price_id
PRICE_ID_30D=price_your_30day_price_id

# Where Stripe sends users back after checkout
FRONTEND_URL=http://localhost:5173
